<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <Button
        android:id="@+id/fogModeButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:text="@string/show_black_fog" />

    <Button
        android:id="@+id/trackingButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:text="@string/start_tracking" />

    <TextView
        android:id="@+id/discoveredPercentText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="16dp"
        android:background="#99000000"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:text="@string/discovered_percent_default"
        android:textColor="@android:color/white"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/currentCityText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:background="#99000000"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:text="@string/current_city_unknown"
        android:textColor="@android:color/white"
        android:textSize="16sp" />
    <Button
        android:id="@+id/editButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_margin="16dp"
        android:text="@string/edit_mode_enter" />

    <TextView
        android:id="@+id/editModeHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_margin="16dp"
        android:background="#99000000"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:text="@string/edit_mode_hint"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:visibility="gone" />

</FrameLayout>
